{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "38;2;255;182;193",
      "2": "38;2;254;240;197"
    }
  },
  "display": {
    "separator": " > ",
    "color": {
      "keys": "38;2;230;140;160",
      "output": "38;2;245;240;235",
      "title": "38;2;140;180;140"
    }
  },
  "modules": [
    { "type": "title", "key": " " },
    { "type": "os", "key": " os" },
    { "type": "host", "key": " host" },
    { "type": "kernel", "key": " ker" },
    { "type": "uptime", "key": " up" },
    { "type": "packages", "key": " pkgs" },
    { "type": "shell", "key": " sh" },
    { "type": "de", "key": " de" }
  ]
}
