<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="root-menu" label="Labwc">

    <!-- Aplicaciones Principales -->
    <item label="  Terminal">
      <action name="Execute" command="foot" />
    </item>
    <item label="  LibreWolf">
      <action name="Execute" command="librewolf" />
    </item>
    <item label="  Thunar">
      <action name="Execute" command="thunar" />
    </item>
    <item label="{} Editor (Vim)">
      <action name="Execute" command="foot vim" />
    </item>

    <separator />

    <!-- Herramientas del Sistema -->
    <item label="  Lanzador (Rofi)">
      <action name="Execute" command="rofi -show drun" />
    </item>
    <item label="  Control de Volumen">
      <action name="Execute" command="pavucontrol" />
    </item>
    <item label="  Gestor Bluetooth">
      <action name="Execute" command="blueman-manager" />
    </item>
    <item label="  Monitor del Sistema">
      <action name="Execute" command="foot btop" />
    </item>

    <separator />

    <!-- Opciones de Sesión -->
    <item label="  Recargar Configuración">
      <action name="Reconfigure" />
    </item>
    <item label="  Bloquear Pantalla">
      <action name="Execute" command="swaylock -f" />
    </item>
    <item label="  Suspender">
      <action name="Execute" command="systemctl suspend" />
    </item>

    <separator />

    <item label="  Reiniciar">
      <action name="Execute" command="systemctl reboot" />
    </item>
    <item label="  Apagar">
      <action name="Execute" command="systemctl poweroff" />
    </item>
    <item label="  Salir de Labwc">
      <action name="Exit" />
    </item>

  </menu>
</openbox_menu>
