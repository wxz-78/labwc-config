<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>

  <!-- ================================================================== -->
  <!-- 1. NÚCLEO Y TEMAS                                                  -->
  <!-- ================================================================== -->
  <core>
    <gap>5</gap>
  </core>

  <theme>
    <name>auryo</name>
    <cornerRadius>8</cornerRadius>
  </theme>

  <!-- ================================================================== -->
  <!-- 2. ESCRITORIOS VIRTUALES                                           -->
  <!-- ================================================================== -->
  <desktops>
    <number>4</number>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <!-- ================================================================== -->
  <!-- 3. TECLADO Y ATAJOS                                                -->
  <!-- ================================================================== -->
  <keyboard>
    <!-- Sistema y Sesión -->
    <keybind key="W-S-c"><action name="Reconfigure" /></keybind>
    <keybind key="W-S-e"><action name="Exit" /></keybind>

    <!-- Lanzadores Básicos -->
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-d"><action name="Execute" command="rofi -show drun" /></keybind>

    <!-- Capturas de Pantalla (Grim / Slurp) -->
    <!-- Print = pantalla completa | Shift+Print = selección de área -->
    <keybind key="Print">
      <action name="Execute" command="sh -c 'mkdir -p ~/Imágenes &amp;&amp; grim ~/Imágenes/screenshot_$(date +%Y%m%d_%H%M%S).png'" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="sh -c 'mkdir -p ~/Imágenes &amp;&amp; grim -g &quot;$(slurp)&quot; ~/Imágenes/screenshot_$(date +%Y%m%d_%H%M%S)_area.png'" />
    </keybind>

    <!-- Control de Ventanas -->
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-f"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-S-f"><action name="ToggleFullscreen" /></keybind>

    <!-- Navegación entre Escritorios -->
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>

    <!-- Enviar ventana a otro escritorio -->
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>

    <!-- Snapping (Anclar a bordes) -->
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-Up"><action name="SnapToEdge" direction="up" /></keybind>
    <keybind key="W-Down"><action name="SnapToEdge" direction="down" /></keybind>

    <!-- Hardware (Volumen y Brillo) -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +10%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 10%-" />
    </keybind>
  </keyboard>

  <!-- ================================================================== -->
  <!-- 4. RATÓN Y TOUCHPAD                                                -->
  <!-- ================================================================== -->
  <mouse>
    <default>
      <context name="Frame">
        <mousebind button="W-Left" action="Drag"><action name="Move" /></mousebind>
        <mousebind button="W-Right" action="Drag"><action name="Resize" /></mousebind>
      </context>

      <!-- Doble clic en la barra de título: maximizar/restaurar -->
      <context name="Titlebar">
        <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize" /></mousebind>
        <mousebind button="Middle" action="Click"><action name="Lower" /></mousebind>
      </context>
    </default>
  </mouse>

  <libinput>
    <device category="touchpad">
      <tap>yes</tap>
      <naturalScroll>yes</naturalScroll>
    </device>
  </libinput>

  <!-- ================================================================== -->
  <!-- 5. REGLAS DE VENTANAS                                              -->
  <!-- ================================================================== -->
  <windowRules>
    <rule app_id="blueman-manager">
      <property name="floating">yes</property>
    </rule>
    <rule app_id="pavucontrol">
      <property name="floating">yes</property>
    </rule>
  </windowRules>
</labwc_config>
