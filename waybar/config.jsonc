{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,

  "modules-left": [
    "custom/menu",
    "ext-workspace"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "network",
    "battery"
  ],

  // === MÓDULOS IZQUIERDA ===
  "custom/menu": {
    "format": "🌸",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },

  "ext-workspace": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "default": "○",
      "active": "●",
      "urgent": "⊙"
    }
  },

  // === MÓDULO CENTRO ===
  "clock": {
    "format": "󰥔 {:%H:%M}",
    "format-alt": "󰃭 {:%Y-%m-%d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1
    }
  },

  // === MÓDULOS DERECHA ===
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "foot nmtui"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": false
  }
}
